<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_logo"
                android:layout_marginEnd="12dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_restaurant"
                    android:tint="@color/white" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CulinaryExchange"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/btnOpenFilter"
                android:layout_width="48dp"
                android:layout_height="48dp">
                <ImageView
                    android:id="@+id/ivFilter"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_filter_list"
                    android:tint="@color/text_primary" />
            </FrameLayout>
        </LinearLayout>

        <!-- Bottom border -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <!-- Search row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="@color/surface">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="Search recipes…"
                android:inputType="text"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="12dp"
                android:imeOptions="actionSearch"
                android:singleLine="true" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                android:tint="@color/text_secondary"
                android:visibility="gone"
                android:contentDescription="Clear search" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone" />

        <!-- Feed + empty state overlay -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="80dp" />

            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="No recipes match your search"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- Filter Drawer (slides from right) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/filterDrawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface"
        android:elevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Drawer Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Filter &amp; Sort"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnCloseFilter"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_close"
                    android:tint="@color/text_primary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border"
                android:layout_marginBottom="24dp" />

            <!-- Sort Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sort By"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/radioGroupSort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">

                <RadioButton
                    android:id="@+id/radioNewest"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Newest First"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:checked="true"
                    android:buttonTint="@color/primary" />

                <RadioButton
                    android:id="@+id/radioOldest"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Oldest First"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:buttonTint="@color/primary" />

            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border"
                android:layout_marginBottom="24dp" />

            <!-- Category Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                android:layout_marginBottom="32dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="All"
                    android:textSize="14sp"
                    android:checked="true"
                    style="@style/Widget.Material3.Chip.Filter"
                    app:chipCornerRadius="@dimen/chip_corner_radius" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBreakfast"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Breakfast"
                    android:textSize="14sp"
                    style="@style/Widget.Material3.Chip.Filter"
                    app:chipCornerRadius="@dimen/chip_corner_radius" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLunch"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Lunch"
                    android:textSize="14sp"
                    style="@style/Widget.Material3.Chip.Filter"
                    app:chipCornerRadius="@dimen/chip_corner_radius" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDinner"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Dinner"
                    android:textSize="14sp"
                    style="@style/Widget.Material3.Chip.Filter"
                    app:chipCornerRadius="@dimen/chip_corner_radius" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDessert"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Dessert"
                    android:textSize="14sp"
                    style="@style/Widget.Material3.Chip.Filter"
                    app:chipCornerRadius="@dimen/chip_corner_radius" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSnack"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Snack"
                    android:textSize="14sp"
                    style="@style/Widget.Material3.Chip.Filter"
                    app:chipCornerRadius="@dimen/chip_corner_radius" />

            </com.google.android.material.chip.ChipGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border"
                android:layout_marginBottom="24dp" />

            <!-- Reset Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetFilters"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Reset Filters"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="@dimen/button_corner_radius"
                app:strokeColor="@color/border" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
